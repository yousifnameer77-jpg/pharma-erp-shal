# Root-level settings used by docker-compose.yml
POSTGRES_DB=pharma_erp
POSTGRES_USER=pharma_erp
POSTGRES_PASSWORD=change_me
# Password for seeded accounts (admin, accountant, ...). Required in Docker.
SEED_DEFAULT_PASSWORD=change_me_too
# Public URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:8000/api
