APP_NAME="Pharma ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Baghdad"
APP_URL=https://erp.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pharma_erp
DB_USERNAME=pharma_erp
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

CORS_ALLOWED_ORIGINS=https://erp.example.com
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION=480

# REQUIRED before the first seed: choose a strong password.
SEED_DEFAULT_PASSWORD=
