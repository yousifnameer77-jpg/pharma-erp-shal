APP_NAME="Pharma ERP"
APP_ENV=local
APP_KEY=
# Set to false (and APP_ENV=production) outside local development.
APP_DEBUG=true
APP_TIMEZONE="Asia/Baghdad"
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL is the supported database: the migrations rely on CHECK
# constraints and strict UUID types. (SQLite is not supported.)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pharma_erp
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Comma-separated list of frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# API token lifetime in minutes.
SANCTUM_TOKEN_EXPIRATION=720
# Leave empty: the frontend uses Bearer tokens (see config/sanctum.php).
SANCTUM_STATEFUL_DOMAINS=

# Password given to seeded accounts. Local/testing default: Passw0rd!
# In any other environment a random password is generated if this is unset.
SEED_DEFAULT_PASSWORD=
